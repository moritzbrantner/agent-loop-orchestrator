{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contracts:run:v1",
  "title": "Agent Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "state",
    "project",
    "workItem",
    "baseline",
    "conventionSelection",
    "componentSet",
    "agent",
    "authority",
    "attempts",
    "candidates",
    "checks",
    "evaluations",
    "decisions",
    "publications"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "candidate_ready",
        "evaluating",
        "awaiting_decision",
        "integrating",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "localRoot": { "type": "string", "minLength": 1 }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "dependencies", "declaredScope"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "declaredScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha"],
      "properties": {
        "gitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "conventionSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conventionIds", "digest"],
      "properties": {
        "componentVersion": { "type": "string", "minLength": 1 },
        "conventionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9._~+/=-]+$"
        }
      }
    },
    "toolingManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestId", "digest"],
      "properties": {
        "manifestId": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9._~+/=-]+$"
        }
      }
    },
    "componentSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockDigest"],
      "properties": {
        "lockDigest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9._~+/=-]+$"
        },
        "lockUri": { "type": "string", "minLength": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "identity", "configurationDigest"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "promptDigest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9._~+/=-]+$"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9._~+/=-]+$"
        }
      }
    },
    "authority": { "$ref": "urn:agent-contracts:authority:v1" },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attemptId", "number", "workspace", "startedAt", "outcome", "evidence"],
        "properties": {
          "attemptId": { "type": "string", "minLength": 1 },
          "number": { "type": "integer", "minimum": 1 },
          "workspace": { "type": "string", "minLength": 1 },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "outcome": { "enum": ["running", "candidate", "failed", "cancelled"] },
          "providerSessionId": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "urn:agent-contracts:evidence:v1" }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "urn:agent-contracts:candidate:v1" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "urn:agent-contracts:check-result:v1" }
    },
    "evaluations": {
      "type": "array",
      "items": { "$ref": "urn:agent-contracts:evaluation-result:v1" }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decisionId", "candidateIdentity", "decision", "actor", "occurredAt"],
        "properties": {
          "decisionId": { "type": "string", "minLength": 1 },
          "candidateIdentity": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["approved", "rejected", "changes-requested"] },
          "actor": { "type": "string", "minLength": 1 },
          "occurredAt": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publicationId", "kind", "candidateIdentity", "status", "occurredAt", "evidence"],
        "properties": {
          "publicationId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["local-integration", "pull-request", "release"] },
          "candidateIdentity": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "succeeded", "failed"] },
          "externalId": { "type": "string", "minLength": 1 },
          "occurredAt": { "type": "string", "format": "date-time" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "urn:agent-contracts:evidence:v1" }
          }
        }
      }
    }
  }
}
