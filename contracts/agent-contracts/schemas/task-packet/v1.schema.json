{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contracts:task-packet:v1",
  "title": "Bounded Capability Task Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sliceId",
    "workItemId",
    "baseline",
    "primaryConvention",
    "conventionRefs",
    "stage",
    "targetSurfaces",
    "behavioralScope",
    "writeScope",
    "protectedBehavior",
    "excludedCapabilities",
    "dependencies",
    "acceptance",
    "expectedCapabilityState",
    "handoff",
    "authority"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sliceId": { "type": "string", "minLength": 1 },
    "workItemId": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha"],
      "properties": {
        "gitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "primaryConvention": { "type": "string", "minLength": 1 },
    "conventionRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "stage": { "type": "string", "minLength": 1 },
    "targetSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "behavioralScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "writeScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "protectedBehavior": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "excludedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "expectedCapabilityState": {
      "enum": ["absent", "partial", "satisfied", "opted-out"]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRequired",
        "changedPathsRequired",
        "evidenceRequired",
        "unresolvedDependenciesRequired"
      ],
      "properties": {
        "candidateRequired": { "type": "boolean" },
        "changedPathsRequired": { "type": "boolean" },
        "evidenceRequired": { "type": "boolean" },
        "unresolvedDependenciesRequired": { "type": "boolean" }
      }
    },
    "authority": { "$ref": "urn:agent-contracts:authority:v1" }
  }
}
