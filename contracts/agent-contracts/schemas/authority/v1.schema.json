{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contracts:authority:v1",
  "title": "Agent Authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "readRoots",
    "writeRoots",
    "network",
    "tools",
    "secretRefs",
    "maxDurationSeconds",
    "maxAttempts",
    "mayIntegrate",
    "mayPublish"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "readRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "writeRoots": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowedDomains"],
      "properties": {
        "mode": { "enum": ["none", "allowlist", "unrestricted"] },
        "allowedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "allowlist" } }, "required": ["mode"] },
          "then": { "properties": { "allowedDomains": { "minItems": 1 } } }
        }
      ]
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "secretRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "maxDurationSeconds": { "type": "integer", "minimum": 1 },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
    "mayIntegrate": { "type": "boolean" },
    "mayPublish": { "type": "boolean" }
  }
}
