{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contracts:component-lock:v1",
  "title": "Component Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "channel", "resolver", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "channel": { "enum": ["stable", "canary", "dev"] },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/releaseComponent" },
          { "$ref": "#/$defs/localComponent" }
        ]
      }
    }
  },
  "$defs": {
    "protocols": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "releaseComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version", "repository", "gitSha", "tag", "digest", "protocols"],
      "properties": {
        "source": { "const": "release" },
        "version": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "gitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9._~+/=-]+$"
        },
        "protocols": { "$ref": "#/$defs/protocols" }
      }
    },
    "localComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "gitSha", "dirty", "contentDigest", "protocols"],
      "properties": {
        "source": { "const": "local" },
        "path": { "type": "string", "minLength": 1 },
        "gitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "dirty": { "type": "boolean" },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Za-z0-9._~+/=-]+$"
        },
        "protocols": { "$ref": "#/$defs/protocols" }
      }
    }
  }
}
