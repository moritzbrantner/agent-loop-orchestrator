{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moritzbrantner/agent-loop-orchestrator/schemas/run-contract-v1.schema.json",
  "title": "Agent Loop Shared Run Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "project",
    "workItem",
    "baseline",
    "agent",
    "authority",
    "status",
    "attempts",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "workItem": {
      "$ref": "#/$defs/workItem"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "conventionSelection": {
      "$ref": "#/$defs/conventionSelection"
    },
    "toolingManifest": {
      "$ref": "#/$defs/toolingManifest"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "status": {
      "$ref": "#/$defs/runStatus"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*:[0-9a-f]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "runStatus": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "candidate_ready",
        "evaluating",
        "awaiting_decision",
        "integrating",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repositoryRoot"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "repositoryRoot": {
          "$ref": "#/$defs/path"
        },
        "repositoryIdentity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "dependsOn",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitSha",
        "dirty"
      ],
      "properties": {
        "gitSha": {
          "$ref": "#/$defs/gitSha"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "const": false
        }
      }
    },
    "conventionSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ids",
        "resolvedDigest"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "resolvedDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "toolingManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "capabilities"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "identity"
      ],
      "properties": {
        "adapter": {
          "$ref": "#/$defs/id"
        },
        "identity": {
          "$ref": "#/$defs/id"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningLevel": {
          "type": "string",
          "minLength": 1
        },
        "configurationDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "networkAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowedDomains"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "allowlist",
            "unrestricted"
          ]
        },
        "allowedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "allowlist"
              }
            }
          },
          "then": {
            "properties": {
              "allowedDomains": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "none",
                  "unrestricted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "allowedDomains": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readRoots",
        "writeRoots",
        "network",
        "tools",
        "secretRefs",
        "maxDurationSeconds",
        "maxAttempts",
        "mayIntegrate",
        "mayPublish"
      ],
      "properties": {
        "readRoots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "writeRoots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        },
        "network": {
          "$ref": "#/$defs/networkAuthority"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "mayIntegrate": {
          "type": "boolean"
        },
        "mayPublish": {
          "type": "boolean"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git-worktree",
            "checkout",
            "external"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "candidateIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gitSha"
          ],
          "properties": {
            "gitSha": {
              "$ref": "#/$defs/gitSha"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patchDigest"
          ],
          "properties": {
            "patchDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "changedPaths",
        "producedAt"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        },
        "producedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "digest",
        "createdAt"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "candidate",
        "outcome",
        "startedAt",
        "finishedAt",
        "evidence"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "candidate": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "missing",
            "skipped"
          ]
        },
        "exitCode": {
          "type": "integer"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator",
        "candidate",
        "outcome",
        "startedAt",
        "finishedAt",
        "evidence"
      ],
      "properties": {
        "evaluator": {
          "$ref": "#/$defs/id"
        },
        "candidate": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "inconclusive",
            "error"
          ]
        },
        "summary": {
          "type": "string"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "outcome",
        "workspace",
        "startedAt",
        "checks",
        "evaluations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "running",
            "candidate_produced",
            "failed",
            "cancelled"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkResult"
          }
        },
        "evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evaluation"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "actor",
        "outcome",
        "decidedAt"
      ],
      "properties": {
        "candidate": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "actor": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": [
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "reason": {
          "type": "string"
        },
        "decidedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "kind",
        "outcome",
        "occurredAt",
        "evidence"
      ],
      "properties": {
        "candidate": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "kind": {
          "enum": [
            "local-integration",
            "pull-request",
            "release"
          ]
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}
